# AI中转站服务器环境变量示例（复制为 .env 使用）
SERVER_PORT=8080
GIN_MODE=debug

# 数据库：本地开发用 sqlite 免安装；生产切 mysql
DB_DRIVER=sqlite
DB_NAME=ai_girl_battle
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=

# Redis 可选（本地开发默认关）
REDIS_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT
JWT_SECRET=ai-girl-battle-dev-secret
# JWT 过期时间（小时）
JWT_EXPIRE=72

# 微信小游戏（留空 = 开发模拟模式 openid=dev_<code>）
WX_APPID=
WX_SECRET=

# 配置中心管理凭证（PUT /config/:key 用）
ADMIN_TOKEN=dev-admin-token
